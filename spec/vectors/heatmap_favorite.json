{
  "about": "The seeks of one track -> the listener's favorite part, or null. spec/ALGORITHM.md section 4.",
  "input_format": "seeks all belong to one track; a seek is a rewind when to_ms < from_ms, else a forward skip",
  "cases": [
    {
      "name": "no seeks",
      "seeks": [],
      "expected": null
    },
    {
      "name": "one rewind is not enough",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 105000}
      ],
      "expected": null
    },
    {
      "name": "rewinds to the same spot in two listens",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 105000},
        {"listen": 2, "from_ms": 128000, "to_ms": 106000}
      ],
      "expected": {"target_ms": 105000, "points": 6, "listens": 2}
    },
    {
      "name": "a rewind and a forward skip make 5 points, enough",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 105000},
        {"listen": 2, "from_ms": 60000, "to_ms": 107000}
      ],
      "expected": {"target_ms": 105000, "points": 5, "listens": 2}
    },
    {
      "name": "two forward skips make 4 points, not enough",
      "seeks": [
        {"listen": 1, "from_ms": 30000, "to_ms": 90000},
        {"listen": 2, "from_ms": 31000, "to_ms": 91000}
      ],
      "expected": null
    },
    {
      "name": "many seeks in a single listen are not enough",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 105000},
        {"listen": 1, "from_ms": 125000, "to_ms": 105500},
        {"listen": 1, "from_ms": 127000, "to_ms": 106000}
      ],
      "expected": null
    },
    {
      "name": "arrivals more than 5 s apart are different places",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 100000},
        {"listen": 2, "from_ms": 130000, "to_ms": 106000}
      ],
      "expected": null
    },
    {
      "name": "arrivals exactly 5 s apart are the same place",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 100000},
        {"listen": 2, "from_ms": 130000, "to_ms": 105000}
      ],
      "expected": {"target_ms": 100000, "points": 6, "listens": 2}
    },
    {
      "name": "close arrivals chain into one region; the target is the middle one",
      "seeks": [
        {"listen": 1, "from_ms": 130000, "to_ms": 100000},
        {"listen": 2, "from_ms": 130000, "to_ms": 108000},
        {"listen": 3, "from_ms": 130000, "to_ms": 104000}
      ],
      "expected": {"target_ms": 104000, "points": 9, "listens": 3}
    },
    {
      "name": "the region with more points wins",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 2, "from_ms": 90000, "to_ms": 61000},
        {"listen": 1, "from_ms": 180000, "to_ms": 150000},
        {"listen": 2, "from_ms": 180000, "to_ms": 151000},
        {"listen": 3, "from_ms": 180000, "to_ms": 152000}
      ],
      "expected": {"target_ms": 151000, "points": 9, "listens": 3}
    },
    {
      "name": "on equal points, more listens win",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 1, "from_ms": 90000, "to_ms": 61000},
        {"listen": 2, "from_ms": 90000, "to_ms": 62000},
        {"listen": 1, "from_ms": 180000, "to_ms": 150000},
        {"listen": 2, "from_ms": 180000, "to_ms": 151000},
        {"listen": 3, "from_ms": 180000, "to_ms": 152000}
      ],
      "expected": {"target_ms": 151000, "points": 9, "listens": 3}
    },
    {
      "name": "on a full tie, the earlier region wins",
      "seeks": [
        {"listen": 1, "from_ms": 180000, "to_ms": 150000},
        {"listen": 2, "from_ms": 180000, "to_ms": 151000},
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 2, "from_ms": 90000, "to_ms": 61000}
      ],
      "expected": {"target_ms": 60000, "points": 6, "listens": 2}
    },
    {
      "name": "a bigger region from a single listen loses to a smaller habit",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 1, "from_ms": 90000, "to_ms": 60500},
        {"listen": 1, "from_ms": 90000, "to_ms": 61000},
        {"listen": 1, "from_ms": 180000, "to_ms": 150000},
        {"listen": 2, "from_ms": 180000, "to_ms": 151000}
      ],
      "expected": {"target_ms": 150000, "points": 6, "listens": 2}
    },
    {
      "name": "only the 10 most recent listens with seeks count",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 2, "from_ms": 90500, "to_ms": 60500},
        {"listen": 3, "from_ms": 91000, "to_ms": 61000},
        {"listen": 4, "from_ms": 10000, "to_ms": 200000},
        {"listen": 5, "from_ms": 10000, "to_ms": 210000},
        {"listen": 6, "from_ms": 10000, "to_ms": 220000},
        {"listen": 7, "from_ms": 10000, "to_ms": 230000},
        {"listen": 8, "from_ms": 10000, "to_ms": 240000},
        {"listen": 9, "from_ms": 10000, "to_ms": 250000},
        {"listen": 10, "from_ms": 10000, "to_ms": 260000},
        {"listen": 11, "from_ms": 10000, "to_ms": 270000},
        {"listen": 12, "from_ms": 180000, "to_ms": 150000},
        {"listen": 13, "from_ms": 181000, "to_ms": 151000}
      ],
      "expected": {"target_ms": 150000, "points": 6, "listens": 2}
    },
    {
      "name": "listens without seeks do not push old seeks out",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 2, "from_ms": 91000, "to_ms": 61000},
        {"listen": 50, "from_ms": 10000, "to_ms": 200000}
      ],
      "expected": {"target_ms": 60000, "points": 6, "listens": 2}
    },
    {
      "name": "exactly 10 listens with seeks all count",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 2, "from_ms": 91000, "to_ms": 61000},
        {"listen": 3, "from_ms": 10000, "to_ms": 200000},
        {"listen": 4, "from_ms": 10000, "to_ms": 210000},
        {"listen": 5, "from_ms": 10000, "to_ms": 220000},
        {"listen": 6, "from_ms": 10000, "to_ms": 230000},
        {"listen": 7, "from_ms": 10000, "to_ms": 240000},
        {"listen": 8, "from_ms": 10000, "to_ms": 250000},
        {"listen": 9, "from_ms": 10000, "to_ms": 260000},
        {"listen": 10, "from_ms": 10000, "to_ms": 270000}
      ],
      "expected": {"target_ms": 60000, "points": 6, "listens": 2}
    },
    {
      "name": "the 11th most recent listen with seeks no longer counts",
      "seeks": [
        {"listen": 1, "from_ms": 90000, "to_ms": 60000},
        {"listen": 2, "from_ms": 91000, "to_ms": 61000},
        {"listen": 3, "from_ms": 10000, "to_ms": 200000},
        {"listen": 4, "from_ms": 10000, "to_ms": 210000},
        {"listen": 5, "from_ms": 10000, "to_ms": 220000},
        {"listen": 6, "from_ms": 10000, "to_ms": 230000},
        {"listen": 7, "from_ms": 10000, "to_ms": 240000},
        {"listen": 8, "from_ms": 10000, "to_ms": 250000},
        {"listen": 9, "from_ms": 10000, "to_ms": 260000},
        {"listen": 10, "from_ms": 10000, "to_ms": 270000},
        {"listen": 11, "from_ms": 10000, "to_ms": 280000}
      ],
      "expected": null
    }
  ]
}
