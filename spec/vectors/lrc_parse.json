{
  "about": "LRC text -> timed lines and skipped count. spec/ALGORITHM.md section 3. Lyrics are made up.",
  "input_format": "lrc is a list of strings; the input text is those strings joined with \"\\n\"",
  "cases": [
    {
      "name": "basic lines, including a timed blank one",
      "lrc": ["[00:41.50]la la one", "[00:45.20]la la two", "[00:48.90]"],
      "expected": {
        "lines": [
          {"start_ms": 41500, "text": "la la one"},
          {"start_ms": 45200, "text": "la la two"},
          {"start_ms": 48900, "text": ""}
        ],
        "skipped": 0
      }
    },
    {
      "name": "the fraction is a decimal part of a second, 0 to 3 digits",
      "lrc": [
        "[01:02]a", "[01:02.5]b", "[01:02.50]c", "[01:02.500]d", "[01:02.05]e", "[01:02.005]f"
      ],
      "expected": {
        "lines": [
          {"start_ms": 62000, "text": "a"},
          {"start_ms": 62005, "text": "f"},
          {"start_ms": 62050, "text": "e"},
          {"start_ms": 62500, "text": "b"},
          {"start_ms": 62500, "text": "c"},
          {"start_ms": 62500, "text": "d"}
        ],
        "skipped": 0
      }
    },
    {
      "name": "a colon before the fraction is accepted",
      "lrc": ["[00:12:34]la"],
      "expected": {"lines": [{"start_ms": 12340, "text": "la"}], "skipped": 0}
    },
    {
      "name": "minutes may have any number of digits",
      "lrc": ["[1:05.00]a", "[100:00.00]b"],
      "expected": {
        "lines": [{"start_ms": 65000, "text": "a"}, {"start_ms": 6000000, "text": "b"}],
        "skipped": 0
      }
    },
    {
      "name": "a repeated line written once with several timestamps (compressed LRC)",
      "lrc": ["[00:12.00][00:45.00]chorus la", "[00:20.00]verse la"],
      "expected": {
        "lines": [
          {"start_ms": 12000, "text": "chorus la"},
          {"start_ms": 20000, "text": "verse la"},
          {"start_ms": 45000, "text": "chorus la"}
        ],
        "skipped": 0
      }
    },
    {
      "name": "lines are sorted by time; equal times keep file order",
      "lrc": ["[00:30.00]c", "[00:10.00]a", "[00:30.00]d", "[00:20.00]b"],
      "expected": {
        "lines": [
          {"start_ms": 10000, "text": "a"},
          {"start_ms": 20000, "text": "b"},
          {"start_ms": 30000, "text": "c"},
          {"start_ms": 30000, "text": "d"}
        ],
        "skipped": 0
      }
    },
    {
      "name": "word-level timestamps are removed from the text",
      "lrc": ["[00:10.00]<00:10.00>la <00:10.50>la <00:11.00>"],
      "expected": {"lines": [{"start_ms": 10000, "text": "la la"}], "skipped": 0}
    },
    {
      "name": "ID tags are ignored and not counted as skipped",
      "lrc": [
        "[ar:Some Artist]", "[ti:Some Title]", "[al:Some Album]", "[length: 03:25]",
        "[by:someone]", "[re:Some Tool v1.0]", "[00:01.00]la"
      ],
      "expected": {"lines": [{"start_ms": 1000, "text": "la"}], "skipped": 0}
    },
    {
      "name": "a positive offset makes lyrics earlier, never below zero",
      "lrc": ["[offset:+500]", "[00:00.20]a", "[00:01.00]b"],
      "expected": {
        "lines": [{"start_ms": 0, "text": "a"}, {"start_ms": 500, "text": "b"}],
        "skipped": 0
      }
    },
    {
      "name": "a negative offset makes lyrics later",
      "lrc": ["[offset:-250]", "[00:01.00]a"],
      "expected": {"lines": [{"start_ms": 1250, "text": "a"}], "skipped": 0}
    },
    {
      "name": "the offset applies to every line wherever the tag is; the last one wins",
      "lrc": ["[00:01.00]a", "[offset:100]", "[00:02.00]b", "[offset:300]"],
      "expected": {
        "lines": [{"start_ms": 700, "text": "a"}, {"start_ms": 1700, "text": "b"}],
        "skipped": 0
      }
    },
    {
      "name": "an offset that is not a whole number is skipped and not applied",
      "lrc": ["[offset:fast]", "[offset:+1.5]", "[00:01.00]a"],
      "expected": {"lines": [{"start_ms": 1000, "text": "a"}], "skipped": 2}
    },
    {
      "name": "lines that cannot be read are skipped and counted",
      "lrc": [
        "plain text without a time",
        "[Chorus]",
        "[xx:yy]la",
        "[00:75.00]seconds above 59",
        "[00:01.0000]four fraction digits",
        "[00:01.00]ok"
      ],
      "expected": {"lines": [{"start_ms": 1000, "text": "ok"}], "skipped": 5}
    },
    {
      "name": "non-ASCII digits are not timestamps",
      "lrc": ["[٠٠:٠١.٠٠]la"],
      "expected": {"lines": [], "skipped": 1}
    },
    {
      "name": "Windows and old Mac line breaks, a byte-order mark and surrounding spaces",
      "lrc": ["\ufeff[00:01.00]a\r", "  [00:02.00]  b  \r", "[00:03.00]c\r[00:04.00]d"],
      "expected": {
        "lines": [
          {"start_ms": 1000, "text": "a"},
          {"start_ms": 2000, "text": "b"},
          {"start_ms": 3000, "text": "c"},
          {"start_ms": 4000, "text": "d"}
        ],
        "skipped": 0
      }
    },
    {
      "name": "blank lines are ignored, not skipped",
      "lrc": ["", "   ", "[00:01.00]a", "\t"],
      "expected": {"lines": [{"start_ms": 1000, "text": "a"}], "skipped": 0}
    },
    {
      "name": "empty input",
      "lrc": [],
      "expected": {"lines": [], "skipped": 0}
    }
  ]
}
