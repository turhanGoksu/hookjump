<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows part that can be tested without a player: the track id,
       turning what the media controls say into a reading, the menu, the
       shortcuts, the strip's timing, and the typefaces inside the exe. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The app's own manifest, so the tests get the same Windows controls
         (Common Controls 6) and scaling as the app. -->
    <ApplicationManifest>..\App\app.manifest</ApplicationManifest>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
