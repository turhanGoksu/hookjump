<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: Spotify through Windows' media controls (SMTC), and
       what the listener sees, drawn with Windows' own functions (no UI
       framework). The Windows part of the target framework brings the Windows
       Runtime APIs, Windows.Media.Control among them. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 and later: only what can be tried is promised. Any API
         newer than this needs a version check, or the build fails. -->
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <AssemblyName>hookjump</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- What a release is, published for win-x64 and self-contained: one exe
         with SQLite's own library beside it, nothing unpacked to %TEMP%,
         trimmed to what hookjump uses, not compressed. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Booth\Booth.csproj" />
    <InternalsVisibleTo Include="Hookjump.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The phone's typefaces, from the one copy under android/, carried
         inside the exe with their licenses (SIL Open Font License). -->
    <EmbeddedResource Include="..\..\android\app\src\main\res\font\barlow_condensed_bold.ttf" LogicalName="fonts.barlow_condensed_bold.ttf" />
    <EmbeddedResource Include="..\..\android\app\src\main\res\font\barlow_condensed_semibold.ttf" LogicalName="fonts.barlow_condensed_semibold.ttf" />
    <EmbeddedResource Include="..\..\android\app\src\main\res\font\barlow_condensed_medium.ttf" LogicalName="fonts.barlow_condensed_medium.ttf" />
    <EmbeddedResource Include="..\..\android\app\src\main\res\font\ibm_plex_mono_regular.ttf" LogicalName="fonts.ibm_plex_mono_regular.ttf" />
    <EmbeddedResource Include="..\..\android\app\src\main\res\font\ibm_plex_mono_medium.ttf" LogicalName="fonts.ibm_plex_mono_medium.ttf" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\licenses\BarlowCondensed-OFL.txt" LogicalName="licenses.BarlowCondensed-OFL.txt" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\licenses\IBMPlexMono-OFL.txt" LogicalName="licenses.IBMPlexMono-OFL.txt" />
  </ItemGroup>
</Project>
