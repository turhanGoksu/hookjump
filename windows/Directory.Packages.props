<Project>
  <!-- One version of each package for every project here, like
       android/gradle/libs.versions.toml. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The .NET 10 line; it carries its own SQLite (e_sqlite3), the same on every machine. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
